# dogfood 金丝雀实例的 svc unit 配置。
# 拷贝到 svc 期望的 unit env 路径（见 agent-shell svc 注册），不入 git。
# WRAPPER 与 prod 共用同一个 zsh wrapper；隔离靠 TMUX_HUB_ENV_FILE 指向独立 env 文件。
NAME=tmux-hub-dogfood
LABEL=local.tmux-hub-dogfood
BACKEND=tmux
TMUX_SESSION=tmux-hub-dogfood-svc
WRAPPER=$HOME/.local/lib/local-services/tmux-hub.zsh
LOG=$HOME/.local/var/log/local-services/tmux-hub-dogfood.log
HEALTH_KIND=http
HEALTH_URL="http://127.0.0.1:3102/system/health"
# dogfood 实例 env 文件（隔离 port / socket / db / secret / gate-app 等）。
TMUX_HUB_ENV_FILE=$HOME/.config/tmux-hub/dogfood.env
