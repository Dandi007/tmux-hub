templates:
  # Minimal default: one button → new zsh in $HOME. User can cd and run
  # any command from inside the session. Add more templates here if useful.
  - id: shell
    name: "新建 zsh"
    cwd_choices: ["~"]
    cmd: "zsh"

  # 示例知识库模板。移动端「+」与桌面 drawer 都会列出本文件全部模板供选择,
  # 不再有"必须匹配某常量"的硬编码契约。复制到 ~/.config/tmux-hub/templates.yaml
  # 后改 cwd_choices 为你的知识库绝对路径、cmd 为你的启动器(如 cc -f)。
  #
  # 注意:shell function / alias 不能作为裸 cmd。tmux 经 `/bin/sh -c <cmd>` 启动,
  # 不加载 zsh/bash rc,function/alias 会解析错。需 function 时显式包一层并留兜底 shell:
  #   cmd: "zsh -ic 'cc -f; exec zsh -i'"
  - id: kb-cc
    name: "知识库 cc"
    cwd_choices: ["~"]
    cmd: "sh"
