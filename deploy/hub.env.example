# Copy to ~/.config/tmux-hub/hub.env and edit as needed.
TMUX_HUB_HOST=127.0.0.1
TMUX_HUB_PORT=3101
TMUX_HUB_TEMPLATES_PATH=$HOME/.config/tmux-hub/templates.yaml
TMUX_HUB_SECRET_PATH=$HOME/.config/tmux-hub/hub.secret
TMUX_HUB_LOG_DIR=$HOME/.cache/tmux-hub/logs
# Absolute path to your local tmux-hub checkout (the wrapper requires this).
TMUX_HUB_REPO_DIR=$HOME/code/tmux-hub

# STAGE A WORKAROUND: until cf-access.ts implements real JWT verification (S3 spike),
# DEV_BIND_SECRET=1 lets the SPA bootstrap its loopback hub.secret on first load.
# The edge Cloudflare Access policy still restricts who can reach 127.0.0.1.
# Once JWT verification is in place, switch this to 0.
TMUX_HUB_DEV_BIND_SECRET=1

# 图片上传落盘根目录。建议指向数据盘，避免 ~ 空间紧张。
# 默认 $HOME/Pictures/tmux-hub
# TMUX_HUB_IMAGE_DIR=/Volumes/Data/tmux-hub-images

# 单次上传图片大小上限（字节）。默认 20MB。
# TMUX_HUB_MAX_IMAGE_BYTES=20971520

# === 移动端 shell 态自然语言→命令翻译（flag-gated，默认关）===
# 开启后：pane 停在 zsh/bash 提示符时，移动端输入框的自然语言经 CC Switch 小模型
# 翻译成命令、填回输入框供复核再发送；TUI（Claude Code 等）维持字面直发。
# TMUX_HUB_SUGGEST=1
# 协议 + 端点 + 模型三者须配套：
#   gpt/* GPT-OAuth 反代 → responses 协议（chat/completions 会 404）：
#     TMUX_HUB_SUGGEST_PROTOCOL=responses
#     TMUX_HUB_SUGGEST_ENDPOINT=http://127.0.0.1:15721/v1/responses
#     TMUX_HUB_SUGGEST_MODEL=gpt/gpt-5.4-mini
#   lingzhi/* 等标准网关 → chat 协议（默认）：
#     TMUX_HUB_SUGGEST_PROTOCOL=chat
#     TMUX_HUB_SUGGEST_ENDPOINT=http://127.0.0.1:15721/v1/chat/completions
#     TMUX_HUB_SUGGEST_MODEL=lingzhi/gpt-5.4-mini
# 上下文行数 / 超时（可选，默认 40 / 6000ms）：
# TMUX_HUB_SUGGEST_CAPTURE_LINES=40
# TMUX_HUB_SUGGEST_TIMEOUT_MS=6000
