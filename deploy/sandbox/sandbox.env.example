# hub-sandbox 实例 env。拷贝到 ~/.config/tmux-hub-sandbox/sandbox.env（0600）。
# 只交给容器内的 hub 用户；agent（pane）拿不到这里的任何变量。
# Claude token 另放 ~/.config/tmux-hub-sandbox/claude.env：CLAUDE_CODE_OAUTH_TOKEN=...

# gate-id app 名 = 边缘子域首段（hub-sandbox.qinglinzhang.top）。
TMUX_HUB_GATE_APP=hub-sandbox
# 与宿主 hub.env 中的值相同。
GATE_INJECT_KEY=

# 容器内监听；对外只经 compose 映射到 100.64.0.6:3103。
TMUX_HUB_HOST=0.0.0.0
TMUX_HUB_PORT=3103

TMUX_HUB_DB_PATH=/var/lib/hub/managed-sessions.db
TMUX_HUB_SECRET_PATH=/var/lib/hub/hub.secret
TMUX_HUB_TEMPLATES_PATH=/etc/tmux-hub/templates.yaml
TMUX_HUB_IMAGE_DIR=/var/lib/hub/images
# pane 日志：agent 写（pipe-pane）、hub 读；server.log 单独放 hub 私有目录。
TMUX_HUB_LOG_DIR=/var/log/hub-panes
TMUX_HUB_LOG_FILE=/var/lib/hub/server.log
TMUX_HUB_EMULATOR=1
# 不要设 TMUX_HUB_DEV_BIND_SECRET：它让未鉴权的 GET /system/auth-check 直接返回 hub secret，
# pane 里的 agent 直连 127.0.0.1:3103 就能拿到（#150）。经 edge 的浏览器靠 gate 身份取 secret，不需要它。
# entrypoint.sh 也会丢弃这个变量。
