# dogfood 金丝雀实例 env 配置。
# 后端与 prod 完全隔离：独立端口 / tmux socket / DB / secret / 日志目录。
# 拷贝到 ~/.config/tmux-hub/dogfood.env 并按需填写。
#
# gate-id app 名须与边缘子域首段一致（hub-dogfood.qinglinzhang.top → "hub-dogfood"）。
TMUX_HUB_GATE_APP=hub-dogfood

TMUX_HUB_HOST=127.0.0.1
# dogfood 端口（3102），与 prod 3101 互不冲突。
TMUX_HUB_PORT=3102

# 独立 tmux socket（-L hub-dogfood），dogfood 会话与 prod 完全隔离。
TMUX_HUB_SOCKET=hub-dogfood

# 独立 DB：dogfood 的 managed-sessions 记录不混入 prod。
TMUX_HUB_DB_PATH=$HOME/.cache/tmux-hub-dogfood/managed-sessions.db

# dogfood 独立 secret（不与 prod 共用，防跨实例 token 伪造）。
TMUX_HUB_SECRET_PATH=$HOME/.config/tmux-hub/dogfood.secret

# templates 可与 prod 共享（只读），也可为 dogfood 单独准备一份。
TMUX_HUB_TEMPLATES_PATH=$HOME/.config/tmux-hub/templates.yaml

# 独立日志目录。
TMUX_HUB_LOG_DIR=$HOME/.cache/tmux-hub-dogfood/logs

# dogfood worktree 的绝对路径（wrapper 从此目录起 bun run start）。
# 填 git worktree add 时指定的路径，例如：
#   $HOME/code/worktrees/tmux-hub/dogfood-live
TMUX_HUB_REPO_DIR=$HOME/code/tmux-hub-dogfood

# 独立图片上传目录，避免与 prod 图片混存。
TMUX_HUB_IMAGE_DIR=$HOME/.cache/tmux-hub-dogfood/images

# STAGE A WORKAROUND（同 prod）：首次启动自举 secret 时设为 1。
TMUX_HUB_DEV_BIND_SECRET=1

# 单次上传图片大小上限（字节）。默认 20MB。
# TMUX_HUB_MAX_IMAGE_BYTES=20971520

# === 移动端 shell 态自然语言→命令翻译（flag-gated，默认关）===
# TMUX_HUB_SUGGEST=1
# TMUX_HUB_SUGGEST_PROTOCOL=responses
# TMUX_HUB_SUGGEST_ENDPOINT=http://127.0.0.1:15721/v1/responses
# TMUX_HUB_SUGGEST_MODEL=gpt/gpt-5.4-mini
# TMUX_HUB_SUGGEST_CAPTURE_LINES=40
# TMUX_HUB_SUGGEST_TIMEOUT_MS=6000
