{
  "name": "tmux-hub",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/main.ts",
    "build:web": "vite build",
    "build": "bun run build:web",
    "start": "bun run src/server/main.ts",
    "lint:tests": "bun run tests/helpers/lint-no-default-socket.ts && bun run tests/helpers/lint-no-prod-state.ts",
    "test": "bun run lint:tests && bun test --bail tests/unit tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "screenshots:readme": "playwright test --config scripts/capture-readme.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "hono": "^4.12.21",
    "pino": "^10.3.1",
    "xterm-addon-canvas": "^0.5.0",
    "xterm-addon-webgl": "^0.16.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
