{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": "src",
    "paths": { "@shared/*": ["shared/*"] }
  },
  "include": ["src/**/*", "tests/**/*"]
}
