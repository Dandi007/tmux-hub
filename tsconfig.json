{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": "src",
    "paths": { "@shared/*": ["shared/*"] },
    // Suppress TS5101 deprecation warning for baseUrl (needed for @shared/* path mapping)
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "tests/**/*", "eval/**/*"]
}
